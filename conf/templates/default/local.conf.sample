# Yocto build configuration for the Arduino UNO Q (Qualcomm QRB2210)
# Yocto Project release: wrynose (6.0 LTS) -- Qualcomm Linux 2.x
#
# BSP layer:  meta-qcom-3rdparty (branch wrynose)
# Mirrors the upstream KAS config meta-qcom-3rdparty/ci/uno-q.yml
# (which includes meta-qcom/ci/base.yml).

MACHINE ?= "uno-q"
DISTRO ?= "qcom-distro"

# --- Package / SDK format -------------------------------------------------
PACKAGE_CLASSES ?= "package_rpm"
SDKMACHINE ?= "x86_64"

# --- Shared download / sstate caches ------------------------------------
DL_DIR ?= "${TOPDIR}/../downloads"
SSTATE_DIR ?= "${TOPDIR}/../sstate-cache"

# --- Host/build tuning --------------------------------------------------
BB_NUMBER_THREADS ?= "${@oe.utils.cpu_count()}"
PARALLEL_MAKE ?= "-j ${@oe.utils.cpu_count()}"

PACKAGECONFIG:append:pn-qemu-system-native = " sdl"

# --- QA / images -------------------------------------------------------
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
CONF_VERSION = "1"

# From meta-qcom/ci/base.yml : local_conf_header
INHERIT += "buildstats-summary"
INHERIT += "buildhistory"
INHERIT += "rm_work"
INHERIT += "image-buildinfo"
BUILDHISTORY_COMMIT ?= "1"

# Disk space monitor
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

# Kernel command line additions (from ci/base.yml)
#KERNEL_CMDLINE_EXTRA:append = " qcom_scm.download_mode=1"

# Distro / image feature additions (from ci/base.yml)
#DISTRO_FEATURES:append = " efi pam pni-names"
#EXTRA_IMAGE_FEATURES += "allow-empty-password empty-root-password allow-root-login"
#IMAGE_ROOTFS_EXTRA_SPACE = "307200"
#WATCHDOG_RUNTIME_SEC:pn-systemd = "30"

# Build identifier recorded in /etc/os-release
OS_RELEASE_FIELDS:append = " BUILD_ID"
BUILD_ID ?= "local-${DATETIME}"

# --- qcom-distro extra layers (from meta-qcom/ci/qcom-distro.yml) --------
# meta-virtualization refuses to parse unless "virtualization" is in
# DISTRO_FEATURES; qcom-distro doesn't set it, so skip the sanity check.
SKIP_META_VIRT_SANITY_CHECK = "1"

# --- Optional: CodeLinaro source mirrors (faster fetches) --------------
# MIRRORS:append = " \
#   git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
#   git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
#   https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
#   "

# Remember AUTOREV lookups (git ls-remote) instead of repeating them at every
# parse: meta-qcom's kernel "devupstream" variants track upstream git, and
# with three configurations parsed a slow connection to github.com breaks
# parsing. Nothing here builds those variants.
BB_SRCREV_POLICY = "cache"
